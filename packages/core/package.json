{
  "name": "@tech-docs/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run --project unit --root ../..",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.104",
    "@mdx-js/mdx": "3.1.1",
    "@octokit/rest": "22.0.1",
    "ai": "7.0.152",
    "better-sqlite3": "13.0.3",
    "diff": "8.0.2",
    "drizzle-orm": "0.45.4",
    "remark-directive": "4.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "tree-sitter-wasms": "0.1.13",
    "unified": "11.0.5",
    "web-tree-sitter": "0.27.1",
    "yaml": "2.8.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.15.3",
    "drizzle-kit": "0.31.4",
    "typescript": "5.9.2",
    "vitest": "5.0.5"
  }
}
