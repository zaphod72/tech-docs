# Copy to `.env` (git-ignored). Every value is optional; defaults are shown.
# See plan/implementation-plan.md §9 for the full table.

# Where SQLite, repo clones, caches and the PR outbox live. Default: <repo>/.workspaces
#TECH_DOCS_WORKSPACES_DIR=

# Workbench bind address/port. Pre-release is localhost-only; do not change the host.
TECH_DOCS_HOST=127.0.0.1
TECH_DOCS_PORT=3000

# Preview runner ports (mdx, docusaurus, starlight).
TECH_DOCS_RUNNER_PORTS=3101,3102,3103

# Rewrite model gateway: auto | google | fake
#   auto  -> google when GOOGLE_GENERATIVE_AI_API_KEY is set, otherwise the deterministic fake.
TECH_DOCS_GATEWAY=auto
#GOOGLE_GENERATIVE_AI_API_KEY=
TECH_DOCS_MODEL=gemini-2.5-flash

# GitHub gateway: auto | octokit | outbox
#   auto  -> octokit when GITHUB_TOKEN is set or `gh auth token` succeeds, otherwise the local PR outbox.
TECH_DOCS_GITHUB=auto
#GITHUB_TOKEN=

# Enables the opt-in `e2e` vitest project (spawns runners / local git remotes).
#TECH_DOCS_E2E=1

# debug | info | warn | error
TECH_DOCS_LOG_LEVEL=info
